---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '../styles/global.css';
import { SITE, url } from '../lib/site';
import MotivPrepinac from '../components/MotivPrepinac.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Digitální učební materiál a workshop k tématu big data. ISKM01 Informační vědy, KISK FF MU.' } =
  Astro.props;
const pageTitle = title ? `${title} — ${SITE.nazev}` : `${SITE.nazev} — ${SITE.predmet}`;
const vyvoj = import.meta.env.DEV;

const path = Astro.url.pathname;
const nav = [
  { label: 'Materiál', href: url('material/'), match: (p: string) => p.startsWith(url('material/')) && !p.startsWith(url('material/test/')) },
  { label: 'Workshop', href: url('workshop/'), match: (p: string) => p.startsWith(url('workshop/')) },
  { label: 'Test', href: url('material/test/'), match: (p: string) => p.startsWith(url('material/test/')) },
  { label: 'Úpravy', href: url('verze/'), match: (p: string) => p.startsWith(url('verze/')) },
];
---

<!doctype html>
<html lang="cs" class:list={{ pracovni: vyvoj }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <script is:inline>
      // Nastaví uložený motiv ještě před vykreslením (viz MotivPrepinac.astro)
      // a pracovní režim se stavem rozpracovanosti (?stav zapne, ?stav=0 vypne).
      document.documentElement.classList.add('js');
      try {
        var m = localStorage.getItem('infovedy-motiv');
        if (m === 'svetly' || m === 'tmavy') document.documentElement.dataset.motiv = m;
        var q = new URLSearchParams(location.search);
        if (q.has('stav')) {
          if (q.get('stav') === '0') localStorage.removeItem('infovedy-stav');
          else localStorage.setItem('infovedy-stav', '1');
        }
        if (localStorage.getItem('infovedy-stav') === '1') document.documentElement.classList.add('pracovni');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#obsah">Přeskočit na obsah</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={url()}>
          {SITE.nazev}
          <span class="brand__kod">{SITE.predmetKod}</span>
        </a>
        <div class="site-header__nastroje">
          <nav aria-label="Hlavní navigace">
            <ul class="site-nav">
              {
                nav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={item.match(path) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <MotivPrepinac />
        </div>
      </div>
    </header>
    <main id="obsah" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <span>
          Týmový výstup předmětu {SITE.predmet}, <a href={SITE.instituceUrl}>{SITE.instituce}</a>, {SITE.semestr}.
        </span>
        <a href={url('material/autori/')}>Kdo co dělal</a>
      </div>
    </footer>
  </body>
</html>
