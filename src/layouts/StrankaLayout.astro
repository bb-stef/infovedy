---
/** Jednoduchá stránka mimo učební materiál (workshop, úpravy). */
import BaseLayout from './BaseLayout.astro';
import StavBadge from '../components/StavBadge.astro';
import type { Stav } from '../lib/site';

interface Props {
  title: string;
  popis?: string;
  oznaceni?: string;
  autori?: string[];
  stav?: Stav;
  nadrazena?: { nazev: string; href: string };
}

const { title, popis, oznaceni, autori = [], stav, nadrazena } = Astro.props;
---

<BaseLayout title={title} description={popis}>
  <div class="wrap" style="padding-top: 3rem">
    <header class="page-head">
      {
        (nadrazena || oznaceni) && (
          <p class="label">
            {nadrazena && <a href={nadrazena.href}>{nadrazena.nazev}</a>}
            {nadrazena && oznaceni && ' — '}
            {oznaceni}
          </p>
        )
      }
      <h1>{title}</h1>
      {popis && <p class="lead">{popis}</p>}
      {
        (autori.length > 0 || stav) && (
          <p class="meta">
            {autori.length > 0 && <span>Připravili: {autori.join(', ')}</span>}
            {stav && <StavBadge stav={stav} />}
          </p>
        )
      }
    </header>
    <slot />
  </div>
</BaseLayout>
