---
import BaseLayout from './BaseLayout.astro';
import ObsahMaterialu from '../components/ObsahMaterialu.astro';
import StavBadge from '../components/StavBadge.astro';
import { getKapitoly, type Stav } from '../lib/site';

interface Props {
  /** Číslo kapitoly 01–06. */
  cislo: string;
  title: string;
  popis?: string;
  autori?: string[];
  stav?: Stav;
  aktualizovano?: Date;
  /** Nadřazená stránka (např. u jednotlivé sondy). */
  nadrazena?: { nazev: string; href: string };
  /** Vlastní označení místo „Kapitola N“ (např. „Sonda II“). */
  oznaceni?: string;
}

const { cislo, title, popis, autori = [], stav, aktualizovano, nadrazena, oznaceni } = Astro.props;
const kapitoly = await getKapitoly();
const index = kapitoly.findIndex((k) => k.cislo === cislo);
const predchozi = nadrazena ? undefined : kapitoly[index - 1];
const dalsi = nadrazena ? undefined : kapitoly[index + 1];
const datum = aktualizovano?.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={title} description={popis}>
  <div class="wrap material">
    <aside class="material__aside" aria-label="Obsah materiálu">
      <p class="label">Učební materiál</p>
      <ObsahMaterialu kapitoly={kapitoly} aktivni={cislo} />
    </aside>

    <details class="material__toc-mobile">
      <summary>Obsah materiálu</summary>
      <ObsahMaterialu kapitoly={kapitoly} aktivni={cislo} />
    </details>

    <article class="material__body">
      <header class="page-head">
        <p class="label">
          {nadrazena ? <a href={nadrazena.href}>{nadrazena.nazev}</a> : null}
          {nadrazena && oznaceni ? ' — ' : null}
          {oznaceni ?? (nadrazena ? null : `Kapitola ${Number(cislo)}`)}
        </p>
        <h1>{title}</h1>
        {popis && <p class="lead">{popis}</p>}
        {
          (autori.length > 0 || datum || stav) && (
            <p class="meta">
              {autori.length > 0 && <span>Text: {autori.join(', ')}</span>}
              {datum && <span>Aktualizováno {datum}</span>}
              {stav && <StavBadge stav={stav} />}
            </p>
          )
        }
      </header>

      <slot />

      {
        (predchozi || dalsi) && (
          <nav class="pager" aria-label="Další kapitoly">
            {predchozi && (
              <a href={predchozi.href} rel="prev">
                <span class="mono">← Kapitola {Number(predchozi.cislo)}</span>
                <span>{predchozi.nazev}</span>
              </a>
            )}
            {dalsi && (
              <a href={dalsi.href} rel="next" class="pager__next">
                <span class="mono">Kapitola {Number(dalsi.cislo)} →</span>
                <span>{dalsi.nazev}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>
  </div>
</BaseLayout>
