---
/**
 * Přepínač barevného motivu: Podle systému / Světlý / Tmavý.
 * Volba se ukládá do localStorage (klíč „infovedy-motiv“); „Podle systému“ ji maže.
 * Počáteční motiv nastavuje inline skript v <head> (BaseLayout), aby stránka neblikla.
 * Bez JavaScriptu je přepínač skrytý a web se řídí systémem.
 */
const volby = [
  { hodnota: 'system', text: 'auto', popis: 'Motiv podle systému' },
  { hodnota: 'svetly', text: 'světlý', popis: 'Světlý motiv' },
  { hodnota: 'tmavy', text: 'tmavý', popis: 'Tmavý motiv' },
] as const;
---

<div class="motiv" role="group" aria-label="Barevný motiv">
  {
    volby.map((v) => (
      <button type="button" class="motiv__volba" data-motiv-volba={v.hodnota} aria-pressed="false" title={v.popis}>
        {v.text}
      </button>
    ))
  }
</div>

<script>
  const KLIC = 'infovedy-motiv';
  type Motiv = 'svetly' | 'tmavy';
  const tlacitka = document.querySelectorAll<HTMLButtonElement>('[data-motiv-volba]');

  function nacti(): Motiv | null {
    try {
      const v = localStorage.getItem(KLIC);
      return v === 'svetly' || v === 'tmavy' ? v : null;
    } catch {
      return null;
    }
  }

  function zobraz(motiv: Motiv | null) {
    if (motiv) document.documentElement.dataset.motiv = motiv;
    else delete document.documentElement.dataset.motiv;
    const aktivni = motiv ?? 'system';
    tlacitka.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.motivVolba === aktivni)));
  }

  tlacitka.forEach((t) =>
    t.addEventListener('click', () => {
      const volba = t.dataset.motivVolba;
      const motiv: Motiv | null = volba === 'svetly' || volba === 'tmavy' ? volba : null;
      try {
        if (motiv) localStorage.setItem(KLIC, motiv);
        else localStorage.removeItem(KLIC);
      } catch {
        /* úložiště nedostupné — motiv platí jen pro tuto stránku */
      }
      zobraz(motiv);
    }),
  );

  // Změna v jiné záložce
  window.addEventListener('storage', (e) => {
    if (e.key === KLIC || e.key === null) zobraz(nacti());
  });

  zobraz(nacti());
</script>
