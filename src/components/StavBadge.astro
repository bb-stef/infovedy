---
/**
 * Stav rozpracovanosti textu. Zobrazuje se jen v pracovním režimu
 * (npm run dev, nebo web otevřený s ?stav) — viz BaseLayout.
 */
import { STAV_POPIS, type Stav } from '../lib/site';

interface Props {
  stav: Stav;
  /** Jen tečka bez textu (v obsahu). */
  tecka?: boolean;
}

const { stav, tecka = false } = Astro.props;
---

{
  tecka ? (
    <span class={`stav-tecka stav-${stav} jen-pracovni`} title={`Stav: ${STAV_POPIS[stav]}`}>
      <span class="sr-only">Stav: {STAV_POPIS[stav]}</span>
    </span>
  ) : (
    <span class={`stav stav-${stav} jen-pracovni`}>
      <span class={`stav-tecka stav-${stav}`} aria-hidden="true" style="display:inline-block" />
      {STAV_POPIS[stav]}
    </span>
  )
}
