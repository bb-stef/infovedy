---
import { getCollection, render } from 'astro:content';
import StrankaMaterialu from '../../../components/StrankaMaterialu.astro';
import StavBadge from '../../../components/StavBadge.astro';

const anotace = await Promise.all(
  (await getCollection('anotace'))
    .sort((a, b) => a.data.poradi - b.data.poradi)
    .map(async (a) => ({ ...a, Content: (await render(a)).Content })),
);
---

<StrankaMaterialu id="literatura" cislo="04">
  <section slot="pred" aria-labelledby="anotace-nadpis" style="margin-bottom: 3rem">
    <h2 id="anotace-nadpis" style="margin-top: 0">Klíčové texty</h2>
    <p class="upozorneni">
      <span>U každého textu uvádíme, jak navazuje na téma, co přináší a jak byl přijat.</span>
    </p>
    {
      anotace.length === 0 ? (
        <div class="prazdne">
          <p>
            Anotace připravujeme.
            <span class="jen-pracovni"> Šablona: <code>src/content/anotace/_sablona.md</code>.</span>
          </p>
        </div>
      ) : (
        anotace.map(({ data, Content }) => (
          <article class="anotace">
            <p class="label">
              {data.poradi}. text
              {data.autori.length > 0 && <span class="mono"> — anotace: {data.autori.join(', ')}</span>}
            </p>
            <h3>{data.title}</h3>
            <p class="anotace__citace">
              {data.citace} {data.odkaz && <a href={data.odkaz}>{data.odkaz}</a>}
            </p>
            <StavBadge stav={data.stav} />
            <div class="prose">
              <Content />
            </div>
          </article>
        ))
      )
    }
    <h2 style="margin-top: 3.5rem">Seznam použité literatury</h2>
  </section>
</StrankaMaterialu>
