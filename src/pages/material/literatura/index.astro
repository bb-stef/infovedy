---
import { getCollection, render } from 'astro:content';
import StrankaMaterialu from '../../../components/StrankaMaterialu.astro';
import StavBadge from '../../../components/StavBadge.astro';

const anotace = await Promise.all(
  (await getCollection('anotace'))
    .sort((a, b) => a.data.poradi - b.data.poradi)
    .map(async (a) => ({ ...a, Content: (await render(a)).Content })),
);
---

<StrankaMaterialu id="literatura" cislo="04">
  <section slot="pred" aria-labelledby="anotace-nadpis" style="margin-bottom: 3rem">
    <h2 id="anotace-nadpis" style="margin-top: 0">Klíčové anotované texty</h2>
    <p class="mono">U každého textu: návaznost na téma · přínos · percepce</p>
    {
      anotace.length === 0 ? (
        <div class="prazdne">
          <p>
            Zatím žádné anotace. Šablona je v <code>src/content/anotace/_sablona.md</code>.
          </p>
        </div>
      ) : (
        anotace.map(({ data, Content }) => (
          <article class="anotace">
            <p class="meta">
              <span>{String(data.poradi).padStart(2, '0')}</span>
              {data.autori.length > 0 && <span>anotace: {data.autori.join(', ')}</span>}
              <StavBadge stav={data.stav} />
            </p>
            <h2>{data.title}</h2>
            <p class="anotace__citace">
              {data.citace} {data.odkaz && <a href={data.odkaz}>{data.odkaz}</a>}
            </p>
            <div class="prose">
              <Content />
            </div>
          </article>
        ))
      )
    }
    <h2 style="margin-top: 3rem">Seznam použité literatury</h2>
  </section>
</StrankaMaterialu>
