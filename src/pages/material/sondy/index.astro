---
import { getCollection } from 'astro:content';
import MaterialLayout from '../../../layouts/MaterialLayout.astro';
import StavBadge from '../../../components/StavBadge.astro';
import { rimske, url } from '../../../lib/site';

const sondy = (await getCollection('sondy')).sort((a, b) => a.data.poradi - b.data.poradi);
---

<MaterialLayout
  cislo="03"
  title="Sondy"
  popis="Co se v tématu big data zkoumá nebo aplikačně řeší a jak. Každá sonda odpovídá na stejné otázky: co se zkoumá, jakými daty a metodou, a co z toho plyne."
>
  <ol class="radky">
    {
      sondy.map((s) => (
        <li>
          <a class="radek" href={url(`material/sondy/${s.id}/`)}>
            <span class="radek__cislo">{rimske(s.data.poradi)}</span>
            <span>
              <span class="radek__nazev">{s.data.title}</span>
              {s.data.perex && <span class="radek__popis">{s.data.perex}</span>}
            </span>
            <span class="radek__meta">
              {s.data.autori.length > 0 && <span>{s.data.autori.join(', ')}</span>}
              <StavBadge stav={s.data.stav} />
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</MaterialLayout>
