---
import { getEntry, render } from 'astro:content';
import StrankaLayout from '../../layouts/StrankaLayout.astro';
import { SITE, url } from '../../lib/site';

const entry = await getEntry('stranky', 'workshop');
if (!entry) throw new Error('Chybí src/content/stranky/workshop.md');
const { Content } = await render(entry);
const osnova = entry.data.osnova ?? [];
const celkem = osnova.reduce((s, b) => s + b.minuty, 0);

let start = 0;
const bloky = osnova.map((b) => {
  const od = start;
  start += b.minuty;
  return { ...b, od, do: start };
});
const fmt = (m: number) => `${Math.floor(m / 60)}:${String(m % 60).padStart(2, '0')}`;
---

<StrankaLayout
  title={entry.data.title}
  popis={entry.data.popis}
  oznaceni="Část druhá"
  autori={entry.data.autori}
  stav={entry.data.stav}
>
  <section aria-labelledby="aktivity">
    <h2 id="aktivity" style="margin-top: 0">Do hodiny</h2>
    <ol class="radky">
      <li>
        <a class="radek" href={url('workshop/big-data-nebo-ne/')}>
          <span class="radek__cislo">1</span>
          <span>
            <span class="radek__nazev">Big data, nebo ne?</span>
            <span class="radek__popis">Třídění pojmů v Mentimetru. Zde jako záložní kartičky na projektor nebo k vytištění.</span>
          </span>
        </a>
      </li>
      <li>
        <a class="radek" href={url('workshop/hadanky/')}>
          <span class="radek__cislo">2</span>
          <span>
            <span class="radek__nazev">Hádanky</span>
            <span class="radek__popis">Případy, kdy data vedla ke špatnému závěru. Příčina se odhalí až po diskuzi.</span>
          </span>
        </a>
      </li>
      <li>
        {
          SITE.mentimeterUrl ? (
            <a class="radek" href={SITE.mentimeterUrl}>
              <span class="radek__cislo">M</span>
              <span>
                <span class="radek__nazev">Mentimeter</span>
                <span class="radek__popis">Hlasování a brainstorming během workshopu.</span>
              </span>
            </a>
          ) : (
            <div class="radek">
              <span class="radek__cislo">M</span>
              <span>
                <span class="radek__nazev">Mentimeter</span>
                <span class="radek__popis">Odkaz na hlasování doplníme před workshopem.</span>
              </span>
            </div>
          )
        }
      </li>
    </ol>
  </section>

  <section aria-labelledby="program-nadpis">
    <h2 id="program-nadpis">Program</h2>
    <table class="program">
      <tbody>
        {
          bloky.map((b) => (
            <tr>
              <td class="program__cas">
                {fmt(b.od)}–{fmt(b.do)}
                <small>{b.minuty} min</small>
              </td>
              <td>
                <strong>{b.nazev}</strong>
                {b.popis && <p>{b.popis}</p>}
              </td>
            </tr>
          ))
        }
      </tbody>
      <tfoot>
        <tr>
          <td class="program__cas">celkem</td>
          <td>{celkem} minut</td>
        </tr>
      </tfoot>
    </table>
  </section>

  <div class="prose" style="margin-top: 1rem"><Content /></div>
</StrankaLayout>
