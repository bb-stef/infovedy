---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StavBadge from '../components/StavBadge.astro';
import { CILE, SITE, getKapitoly, url } from '../lib/site';

const kapitoly = await getKapitoly();
const sondy = await getCollection('sondy');
const anotace = await getCollection('anotace');
const otazky = await getCollection('otazky');
const rozpracovaneSondy = sondy.filter((s) => s.data.stav !== 'chybi').length;
---

<BaseLayout>
  <div class="wrap">
    <header class="titul">
      <p class="titul__horni">{SITE.predmet} — {SITE.instituce} — {SITE.semestr}</p>
      <h1>Big Data</h1>
      <p class="titul__podtitul">Studijní materiál a&nbsp;workshop o&nbsp;tom, co velká data jsou, k&nbsp;čemu slouží a&nbsp;kde selhávají.</p>
    </header>

    <div class="titul-obsah">
      <section aria-labelledby="obsah-nadpis">
        <h2 id="obsah-nadpis"><a href={url('material/')}>Učební materiál</a></h2>
        <ol class="knizni-obsah">
          {
            kapitoly.map((k) => (
              <li>
                <a href={k.href}>
                  <span class="toc__cislo">{Number(k.cislo)}</span>
                  <span class="toc__nazev">{k.nazev}</span>
                  <span class="voditko" aria-hidden="true" />
                  <StavBadge stav={k.stav} tecka />
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <div>
        <section class="blok" aria-labelledby="workshop-nadpis">
          <h2 id="workshop-nadpis"><a href={url('workshop/')}>Workshop</a></h2>
          <p>Pětačtyřicet minut práce s&nbsp;reálnými případy pro dvě další skupiny.</p>
          <ul class="terminy">
            {SITE.terminyWorkshopu.map((t, i) => (
              <li>
                <span class="mono">{i + 1}. termín</span>
                <span>{t}</span>
              </li>
            ))}
          </ul>
          <p><a href={url('workshop/')}>Program a aktivity</a></p>
        </section>

        <section class="blok tiraz" aria-labelledby="tiraz-nadpis">
          <h2 id="tiraz-nadpis">Připravili</h2>
          <p>{SITE.tym.join(', ')}.</p>
          <p>
            Materiál prochází dvěma koly úprav podle zpětné vazby — co se změnilo, je v&nbsp;<a href={url('verze/')}>úpravách</a>.
          </p>
        </section>
      </div>
    </div>

    <aside class="pracovni-poznamka jen-pracovni" aria-label="Stav rozpracovanosti">
      <p>
        <strong>Pracovní režim.</strong> Sondy {rozpracovaneSondy}/{CILE.sondy}, anotace {anotace.length}/{CILE.anotaceMin}–{CILE.anotaceMax},
        otázky {otazky.length}/{CILE.otazky}. Vidí jen tým (vypnout: <a href="?stav=0">?stav=0</a>).
      </p>
    </aside>
  </div>
</BaseLayout>
